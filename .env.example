# Educated Trades — Environment template
# Copy this file to `.env` and fill in your own credentials:
#     cp .env.example .env
# Then load it before starting the backend:
#     set -a; source .env; set +a
#
# NEVER commit your real `.env` — it is excluded via .gitignore.


# --- Alpaca (paper/live trading) ---------------------------------------
# Create keys at https://alpaca.markets. Start with PAPER keys.
#
# The environment is DERIVED from these, not configured separately:
#   PK… key, or a paper-api URL   -> paper
#   AK… key, or api.alpaca.markets -> live
#   anything ambiguous             -> paper
#
# Swapping in live keys switches the endpoint AND the data directory
# together, so there is no "remember to change DATA_DIR" step to forget.
# If unset, the backend runs in SIMULATION mode and places no real orders.
APCA_API_KEY_ID=your_alpaca_key_id_here
APCA_API_SECRET_KEY=your_alpaca_secret_key_here

# Optional. Leave unset and the endpoint follows the key prefix above.
# Paper: https://paper-api.alpaca.markets   Live: https://api.alpaca.markets
# APCA_BASE_URL=https://paper-api.alpaca.markets


# --- Control API -------------------------------------------------------
# REQUIRED. The API can change mode and place trades, so the process
# refuses to start without a token — on every startup path, including
# --api-only. Generate one with:  openssl rand -hex 32
API_AUTH_TOKEN=

# The API listens on loopback only by default. Widen this ONLY behind a
# firewall or a reverse proxy that terminates TLS. Setting 0.0.0.0 puts
# POST /api/execute in front of anything that can reach the port.
# API_BIND=127.0.0.1
# API_PORT=3099


# --- Data paths --------------------------------------------------------
# Set DATA_ROOT, not DATA_DIR.
#
# The bot appends the environment itself: $DATA_ROOT/paper or $DATA_ROOT/live.
# Paper and live must never share a ledger, journal or pattern store —
# paper fills are optimistic and IEX-only, so mixing them contaminates the
# slippage measurement that real money exists to produce.
#
# Setting DATA_DIR explicitly OVERRIDES that split and puts both
# environments in one directory. Preflight will warn if it finds one.
# Default works without sudo on any machine. On a Linux server running as a
# service user, /var/lib/educated-trades is the conventional choice — but it
# requires root to create, so it is not a sane default for a laptop.
DATA_ROOT=~/.educated-trades


# --- News (optional) ---------------------------------------------------
# Free API key: https://finnhub.io/register
# If unset, the backend fails closed — no fabricated headlines.
FINNHUB_API_KEY=


# --- Backups (optional) ------------------------------------------------
# A backup repository YOU own, over SSH. There is deliberately no default:
# a hardcoded one means a forked project pushes its data into the original
# project's backup repo, where both overwrite each other's snapshots.
#
# Unset = local snapshots only, nothing pushed off the machine.
BACKUP_REMOTE_URL=
# BACKUP_RETENTION_DAYS=30


# --- Monitoring -------------------------------------------------------
# STRONGLY RECOMMENDED. Without this, every critical alert — kill switch
# engaged, a position running unprotected, the daily loss limit hit — is
# written only to a database on the same machine that may be the thing that
# has failed. You would not find out until you next looked.
#
# Discord: server → channel → Edit Channel → Integrations → Webhooks → New.
# Install the Discord phone app and you get push notifications for free.
WATCHDOG_DISCORD_WEBHOOK=

# Optional: send critical/error alerts somewhere different from the
# heartbeat alerts. Defaults to WATCHDOG_DISCORD_WEBHOOK above.
ALERT_WEBHOOK_URL=

# Do not repeat the same alert type more often than this (seconds).
# ALERT_REPEAT_SECONDS=900


# --- Web dashboard (optional) -----------------------------------------
# The dashboard server reads API_AUTH_TOKEN from this same file and talks to
# the bot server-to-server, so the token never reaches the browser. Export it
# in whatever environment runs `vite dev` / `bun run start`.
#
# Override only if the bot is not on loopback:
# BOT_API_BASE=http://127.0.0.1:3099/api


# --- Risk controls (optional overrides) --------------------------------
# Every one of these has a working default. Change them deliberately —
# see OPERATIONS.md for the reasoning behind each number.
#
# Daily loss limit as a percentage of starting equity. Persisted, so it
# survives a restart.
# DAILY_LOSS_LIMIT_PCT=3.0
# MAX_TOTAL_EXPOSURE=0.30
# MAX_CONCURRENT_POSITIONS=3
# BAR_TIMEFRAME_MINUTES=30
# TRADING_SYMBOLS=SPY,QQQ,IWM,XLE,TLT,GLD


# --- Operating mode ----------------------------------------------------
# NOT set here. Mode is owned by $DATA_DIR/orchestrator_mode.txt and
# changed with POST /api/mode. There is no environment variable and no CLI
# flag for it — the bot starts MANUAL unless that file says otherwise.
# See docs/MODE_PRECEDENCE.md.
