{
  "include": ["**/*.ts", "**/*.tsx"],
  // site/ is the superseded pre-hardening dashboard: its api.ts sends no
  // Authorization header, so it 401s against the current backend, and it has
  // no routeTree.gen. Typechecking it contributed 20 errors that were not
  // about the live tree and buried one that was. Excluded rather than
  // deleted, pending a decision on removing the directory outright.
  "exclude": ["node_modules", "dist", "site"],
  "compilerOptions": {
    "target": "ES2022",
    "jsx": "react-jsx",
    "module": "ESNext",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    // "bun" is required for serve.ts: Bun.serve / Bun.file / import.meta.dir
    // are globals tsc cannot otherwise see, which produced 4 errors in a file
    // that runs correctly.
    "types": ["vite/client", "bun"],

    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,

    "skipLibCheck": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true,
    "baseUrl": ".",
    "paths": {
      "~/*": ["./src/*"]
    },

    "esModuleInterop": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "allowJs": true,
    "forceConsistentCasingInFileNames": true
  }
}
