<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.educatedtrades.opening-preopen-conditional-forward</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>/Users/shaym/Documents/Educated Trades/main5-opening-causal/scripts/run_opening_preopen_conditional_forward.sh</string>
  </array>

  <key>WorkingDirectory</key>
  <string>/Users/shaym/Documents/Educated Trades/main5-opening-causal</string>

  <!-- 15:35 CT is 16:35 ET. The observer independently enforces the
       post-close boundary and the Alpaca cash-session calendar. -->
  <key>StartCalendarInterval</key>
  <array>
    <dict><key>Weekday</key><integer>2</integer><key>Hour</key><integer>15</integer><key>Minute</key><integer>35</integer></dict>
    <dict><key>Weekday</key><integer>3</integer><key>Hour</key><integer>15</integer><key>Minute</key><integer>35</integer></dict>
    <dict><key>Weekday</key><integer>4</integer><key>Hour</key><integer>15</integer><key>Minute</key><integer>35</integer></dict>
    <dict><key>Weekday</key><integer>5</integer><key>Hour</key><integer>15</integer><key>Minute</key><integer>35</integer></dict>
    <dict><key>Weekday</key><integer>6</integer><key>Hour</key><integer>15</integer><key>Minute</key><integer>35</integer></dict>
  </array>

  <key>ProcessType</key>
  <string>Background</string>
  <key>LowPriorityIO</key>
  <true/>
  <key>Nice</key>
  <integer>10</integer>
  <key>RunAtLoad</key>
  <false/>
  <key>StandardOutPath</key>
  <string>/Users/shaym/.educated-trades/research/logs/opening_preopen_conditional_forward.out.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/shaym/.educated-trades/research/logs/opening_preopen_conditional_forward.err.log</string>
</dict>
</plist>
